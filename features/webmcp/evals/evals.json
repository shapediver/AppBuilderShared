[
	{
		"id": "list_sessions",
		"tool": "list_sessions",
		"description": "List session ids that offer parameters",
		"input": {},
		"expect": {
			"sessionsCount": 1,
			"sessionIds": ["eval-session"],
			"contentIncludes": "list_parameter_definitions"
		}
	},
	{
		"id": "list_all",
		"tool": "list_parameter_definitions",
		"description": "List all supported parameters",
		"input": {"filter": "all"},
		"expect": {
			"parametersCount": 7,
			"howtoPresent": true,
			"contentIncludes": "set_parameter_values"
		}
	},
	{
		"id": "list_visible",
		"tool": "list_parameter_definitions",
		"description": "List only non-hidden parameters",
		"input": {"filter": "visible"},
		"expect": {
			"parametersCount": 6,
			"parameterIds": [
				"width-int",
				"material-list",
				"paint-color",
				"height-float",
				"enabled-bool",
				"color-list"
			],
			"howtoPresent": true
		}
	},
	{
		"id": "list_omit_session_id",
		"tool": "list_parameter_definitions",
		"description": "Omit sessionId — list all sessions with sessionId+howto on items",
		"input": {"filter": "all"},
		"expect": {
			"parametersCount": 7,
			"howtoPresent": true,
			"contentIncludes": "for 1 sessions"
		}
	},
	{
		"id": "list_valid_session_id",
		"tool": "list_parameter_definitions",
		"description": "Valid sessionId — list only that session's parameters",
		"input": {"filter": "all", "sessionId": "eval-session"},
		"expect": {
			"parametersCount": 7
		}
	},
	{
		"id": "list_invalid_session_id",
		"tool": "list_parameter_definitions",
		"description": "Reject unknown sessionId with recovery hint",
		"input": {"filter": "all", "sessionId": "example_string"},
		"expect": {
			"isError": true,
			"contentIncludes": "does not exist"
		}
	},
	{
		"id": "list_reject_visible_only",
		"tool": "list_parameter_definitions",
		"description": "Reject weak-model alias visibleOnly (use filter instead)",
		"input": {"visibleOnly": true},
		"expect": {"inputSchemaReject": true}
	},
	{
		"id": "list_search_match",
		"tool": "list_parameter_definitions",
		"description": "Search substring matches width-int",
		"input": {"search": "width"},
		"expect": {
			"parametersCount": 1,
			"parameterIds": ["width-int"]
		}
	},
	{
		"id": "list_search_no_match",
		"tool": "list_parameter_definitions",
		"description": "Search with no matches returns empty",
		"input": {"search": "zzzznotfound"},
		"expect": {"parametersCount": 0}
	},
	{
		"id": "list_search_case_insensitive",
		"tool": "list_parameter_definitions",
		"description": "Search is case-insensitive against Width displayname",
		"input": {"search": "WIDTH"},
		"expect": {
			"parametersCount": 1,
			"parameterIds": ["width-int"]
		}
	},
	{
		"id": "list_search_displayname",
		"tool": "list_parameter_definitions",
		"description": "Search matches paint-color via Paint name/displayname",
		"input": {"search": "paint"},
		"expect": {
			"parametersCount": 1,
			"parameterIds": ["paint-color"]
		}
	},
	{
		"id": "list_limit_truncates",
		"tool": "list_parameter_definitions",
		"description": "Limit 2 truncates when more match",
		"input": {"limit": 2},
		"expect": {
			"parametersCount": 2,
			"contentIncludes": "More parameters match",
			"truncated": true
		}
	},
	{
		"id": "list_limit_no_truncate",
		"tool": "list_parameter_definitions",
		"description": "Limit above total does not truncate",
		"input": {"limit": 10},
		"expect": {
			"parametersCount": 7,
			"truncated": false
		}
	},
	{
		"id": "list_offset_paginates",
		"tool": "list_parameter_definitions",
		"description": "offset+limit returns second page and stays truncated when more remain",
		"input": {"limit": 2, "offset": 2},
		"expect": {
			"parametersCount": 2,
			"contentIncludes": "More parameters match",
			"truncated": true
		}
	},
	{
		"id": "list_offset_last_page",
		"tool": "list_parameter_definitions",
		"description": "offset reaching the tail returns remaining params without truncation",
		"input": {"limit": 5, "offset": 5},
		"expect": {
			"parametersCount": 2,
			"truncated": false
		}
	},
	{
		"id": "list_offset_beyond_end",
		"tool": "list_parameter_definitions",
		"description": "offset beyond total returns empty page, no truncation",
		"input": {"limit": 5, "offset": 50},
		"expect": {
			"parametersCount": 0,
			"truncated": false
		}
	},
	{
